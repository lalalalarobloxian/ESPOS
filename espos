// ============ MESSENGER ============
void updateContact(String name, IPAddress ip) {
  for(int i = 0; i < contactCount; i++) {
    if(strcmp(contacts[i].name, name.c_str()) == 0) {
      contacts[i].lastSeen = millis();
      contacts[i].ip = ip;
      return;
    }
  }
 
  if(contactCount < MAX_CONTACTS) {
    name.toCharArray(contacts[contactCount].name, 16);
    contacts[contactCount].ip = ip;
    contacts[contactCount].lastSeen = millis();
    contactCount++;
  }
}

void messengerApp() {
  if(!wifiConnected) {
    Display::clear();
    Display::printCenter(28, "WiFi Required!");
    Display::show();
    Serial.println("WiFi not connected!");
    delay(2000);
    currentApp = "home";
    return;
  }
 
  #ifdef USE_OLED
    Display::clear();
    Display::printCenter(0, "Messenger");
    Display::line(0, 10, 128, 10);
    Display::print(0, 14, "Device: " + deviceName.substring(0, 16));
    Display::print(0, 24, "Contacts: " + String(contactCount));
   
