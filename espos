// ============ DISPLAY CLASS ============
class Display {
public:
  static void init() {
    Serial.begin(115200);
    delay(100);
   
    #ifdef USE_OLED
      if(!oled.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
        Serial.println("OLED init failed!");
        while(1);
      }
      oled.clearDisplay();
      oled.setTextSize(1);
      oled.setTextColor(SSD1306_WHITE);
      oled.display();
    #endif
  }
 
  static void clear() {
    #ifdef USE_OLED
      oled.clearDisplay();
    #else
      for(int i=0; i<10; i++) Serial.println();
      Serial.println("================================");
    #endif
  }
 
  static void show() {
    #ifdef USE_OLED
      oled.display();
    #endif
  }
 
  static void print(int x, int y, String text, int size = 1) {
    #ifdef USE_OLED
      oled.setTextSize(size);
      oled.setCursor(x, y);
      oled.print(text);
    #else
      Serial.println(text);
    #endif
  }
 
  static void printCenter(int y, String text) {
    #ifdef USE_OLED
      oled.setTextSize(1);
      int16_t x1, y1;
      uint16_t w, h;
      oled.getTextBounds(text, 0, 0, &x1, &y1, &w, &h);
      oled.setCursor((SCREEN_WIDTH - w) / 2, y);
      oled.print(text);
    #else
      Serial.println(text);
    #endif
  }
 
  static void rect(int x, int y, int w, int h, bool fill = false) {
    #ifdef USE_OLED
      if(fill) oled.fillRect(x, y, w, h, SSD1306_WHITE);
      else oled.drawRect(x, y, w, h, SSD1306_WHITE);
    #endif
  }
 
  static void line(int x1, int y1, int x2, int y2) {
    #ifdef USE_OLED
      oled.drawLine(x1, y1, x2, y2, SSD1306_WHITE);
    #endif
  }
 
  static void circle(int x, int y, int r, bool fill = false) {
    #ifdef USE_OLED
      if(fill) oled.fillCircle(x, y, r, SSD1306_WHITE);
      else oled.drawCircle(x, y, r, SSD1306_WHITE);
    #endif
  }
 
  static void pixel(int x, int y) {
    #ifdef USE_OLED
      oled.drawPixel(x, y, SSD1306_WHITE);
    #endif
  }
 
  static void progressBar(int x, int y, int w, int h, int val, int max) {
    #ifdef USE_OLED
      oled.drawRect(x, y, w, h, SSD1306_WHITE);
      int fill = (w - 2) * val / max;
      oled.fillRect(x + 1, y + 1, fill, h - 2, SSD1306_WHITE);
    #endif
  }
 
  static void menu(String title, String items[], int cnt, int sel) {
    clear();
    printCenter(0, title);
    line(0, 10, 128, 10);
   
    #ifdef USE_OLED
      for(int i = 0; i < min(cnt, 5); i++) {
        int y = 14 + (i * 10);
        if(i == sel) {
          rect(0, y - 1, 128, 10, true);
          oled.setTextColor(SSD1306_BLACK);
          print(4, y, items[i]);
          oled.setTextColor(SSD1306_WHITE);
        } else {
          print(4, y, items[i]);
        }
      }
    #else
      for(int i = 0; i < cnt; i++) {
        if(i == sel) Serial.println("> " + String(i+1) + ". " + items[i]);
        else Serial.println("  " + String(i+1) + ". " + items[i]);
      }
    #endif
    show();
  }
};

// ============ EEPROM FUNCTIONS ============
void saveWiFi(String ssid, String pass) {
  EEPROM.write(ADDR_WIFI_CONFIGURED, 1);
  for(int i = 0; i < 32; i++) {
    EEPROM.write(ADDR_SSID + i, i < ssid.length() ? ssid[i] : 0);
    EEPROM.write(ADDR_PASSWORD + i, i < pass.length() ? pass[i] : 0);
  }
  EEPROM.commit();
}

bool loadWiFi(String &ssid, String &pass) {
  if(EEPROM.read(ADDR_WIFI_CONFIGURED) != 1) return false;
 
  char s[33] = {0}, p[33] = {0};
  for(int i = 0; i < 32; i++) {
    s[i] = EEPROM.read(ADDR_SSID + i);
    p[i] = EEPROM.read(ADDR_PASSWORD + i);
  }
  ssid = String(s);
  pass = String(p);
  return ssid.length() > 0;
}

void saveScore(int game, int score) {
  int addr = (game == 0) ? ADDR_HIGH_SCORE_FLAPPY :
             (game == 1) ? ADDR_HIGH_SCORE_MARIO : ADDR_HIGH_SCORE_FIGHTER;
  for(int i = 0; i < 4; i++) {
    EEPROM.write(addr + i, (score >> (8 * (3 - i))) & 0xFF);
  }
  EEPROM.commit();
}

int loadScore(int game) {
  int addr = (game == 0) ? ADDR_HIGH_SCORE_FLAPPY :
             (game == 1) ? ADDR_HIGH_SCORE_MARIO : ADDR_HIGH_SCORE_FIGHTER;
  int score = 0;
  for(int i = 0; i < 4; i++) {
    score = (score << 8) | EEPROM.read(addr + i);
  }
  return score;
}

