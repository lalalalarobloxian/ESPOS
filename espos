      unsigned long sec = (millis() - contacts[i].lastSeen) / 1000;
      Display::print(0, 34 + (i * 10), String(contacts[i].name) + " " + String(sec) + "s");
    }
   
    Display::print(0, 54, "Use serial chat");
    Display::show();
  #endif
 
  Serial.println("\n=== MESSENGER PRO ===");
  Serial.println("Device: " + deviceName);
  Serial.println("Contacts: " + String(contactCount));
 
  for(int i = 0; i < contactCount; i++) {
    unsigned long sec = (millis() - contacts[i].lastSeen) / 1000;
    Serial.println(String(i+1) + ". " + String(contacts[i].name) +
                   " (" + contacts[i].ip.toString() + ") - " + String(sec) + "s ago");
  }
 
  Serial.println("\nCommands:");
  Serial.println("@all <message> - Broadcast to all");
  Serial.println("@<name> <msg>  - Direct message");
  Serial.println("/history       - View messages");
  Serial.println("/refresh       - Update contacts");
  Serial.println("b              - Go back");
  Serial.println("");
 
  // Announce presence
  String announcement = "JOIN:" + deviceName;
  udp.beginPacket(IPAddress(255,255,255,255), UDP_PORT);
  udp.write(announcement.c_str());
  udp.endPacket();
 
  unsigned long lastHeartbeat = 0;
  int msgDisplayCount = 0;
 
  while(true) {
    // Periodic heartbeat
    if(millis() - lastHeartbeat > 10000) {
      udp.beginPacket(IPAddress(255,255,255,255), UDP_PORT);
      udp.write(announcement.c_str());
      udp.endPacket();
      lastHeartbeat = millis();
    }
   
    // Check for incoming messages
    int packetSize = udp.parsePacket();
    if(packetSize) {
      char incomingPacket[MAX_MESSAGE_LENGTH];
      int len = udp.read(incomingPacket, MAX_MESSAGE_LENGTH);
      if(len > 0) {
        incomingPacket[len] = 0;
        String msg = String(incomingPacket);
        IPAddress remoteIP = udp.remoteIP();
       
        if(msg.startsWith("MSG:")) {
          String content = msg.substring(4);
          Serial.println("[RX] " + content);
         
          #ifdef USE_OLED
            Display::clear();
            Display::printCenter(0, "New Message!");
            Display::line(0, 10, 128, 10);
           
            // Word wrap message
            int startIdx = max(0, messageHistoryCount - 4);
            for(int i = startIdx; i < messageHistoryCount && i < startIdx + 4; i++) {
              String shortMsg = messageHistory[i].substring(0, 21);
              Display::print(0, 14 + ((i - startIdx) * 10), shortMsg);
            }
           
            Display::show();
          #endif
         
          if(messageHistoryCount < 20) {
            messageHistory[messageHistoryCount++] = content;
          } else {
            // Shift array
            for(int i = 0; i < 19; i++) {
              messageHistory[i] = messageHistory[i + 1];
            }
            messageHistory[19] = content;
          }
        }
        else if(msg.startsWith("DM:")) {
          int separatorPos = msg.indexOf(":", 3);
          String sender = msg.substring(3, separatorPos);
          String content = msg.substring(separatorPos + 1);
          Serial.println("[DM from " + sender + "] " + content);
         
          #ifdef USE_OLED
            Display::clear();
            Display::printCenter(0, "Direct Message");
            Display::line(0, 10, 128, 10);
            Display::print(0, 20, "From: " + sender.substring(0, 16));
            Display::print(0, 35, content.substring(0, 21));
            Display::show();
          #endif
         
          if(messageHistoryCount < 20) {
            messageHistory[messageHistoryCount++] = "[DM] " + sender + ": " + content;
          }
        }
        else if(msg.startsWith("JOIN:")) {
          String name = msg.substring(5);
          updateContact(name, remoteIP);
          Serial.println("[+] " + name + " joined/online");
         
          #ifdef USE_OLED
            Display::clear();
            Display::printCenter(0, "Messenger");
            Display::line(0, 10, 128, 10);
            Display::printCenter(28, name + " online!");
            Display::show();
            delay(1000);
          #endif
        }
      }
    }
   
    // Check for user input
    if(Serial.available()) {
      String input = Serial.readStringUntil('\n');
      input.trim();
     
      if(input == "b") {
        currentApp = "home";
        return;
      }
      else if(input == "/history") {
        Serial.println("\n=== MESSAGE HISTORY ===");
        for(int i = 0; i < messageHistoryCount; i++) {
          Serial.println(messageHistory[i]);
        }
        Serial.println("=======================\n");
      }
      else if(input == "/refresh") {
        Serial.println("Refreshing contacts...");
        udp.beginPacket(IPAddress(255,255,255,255), UDP_PORT);
        udp.write(announcement.c_str());
        udp.endPacket();
       
        #ifdef USE_OLED
          Display::clear();
          Display::printCenter(28, "Refreshing...");
          Display::show();
          delay(1000);
        #endif
      }
      else if(input.startsWith("@all ")) {
        String message = "MSG:" + deviceName + ": " + input.substring(5);
        udp.beginPacket(IPAddress(255,255,255,255), UDP_PORT);
        udp.write(message.c_str());
        udp.endPacket();
        Serial.println("[TX to All] " + input.substring(5));
       
        #ifdef USE_OLED
          Display::clear();
          Display::printCenter(0, "Sent!");
          Display::line(0, 10, 128, 10);
          String shortMsg = input.substring(5, min(26, (int)input.length()));
          Display::printCenter(28, shortMsg);
          Display::show();
          delay(1000);
        #endif
      }
      else if(input.startsWith("@")) {
        int spacePos = input.indexOf(' ');
        if(spacePos > 0) {
          String targetName = input.substring(1, spacePos);
          String message = input.substring(spacePos + 1);
         
          // Find contact
          bool found = false;
          for(int i = 0; i < contactCount; i++) {
            if(String(contacts[i].name) == targetName) {
              String dm = "DM:" + deviceName + ":" + message;
              udp.beginPacket(contacts[i].ip, UDP_PORT);
              udp.write(dm.c_str());
              udp.endPacket();
              Serial.println("[TX to " + targetName + "] " + message);
              found = true;
             
              #ifdef USE_OLED
                Display::clear();
                Display::printCenter(0, "DM Sent!");
                Display::line(0, 10, 128, 10);
                Display::print(0, 20, "To: " + targetName);
                Display::print(0, 35, message.substring(0, 21));
                Display::show();
                delay(1000);
              #endif
              break;
            }
          }
         
          if(!found) {
            Serial.println("[!] Contact not found: " + targetName);
          }
        }
      }
      else if(input.length() > 0) {
        String message = "MSG:" + deviceName + ": " + input;
        udp.beginPacket(IPAddress(255,255,255,255), UDP_PORT);
        udp.write(message.c_str());
        udp.endPacket();
        Serial.println("[TX] " + input);
       
        #ifdef USE_OLED
          Display::clear();
          Display::printCenter(0, "Sent!");
          Display::line(0, 10, 128, 10);
          String shortMsg = input.substring(0, min(21, (int)input.length()));
          Display::printCenter(28, shortMsg);
          Display::show();
          delay(800);
        #endif
      }
     
      Serial.print("> ");
    }
   
    yield();
  }
}

// ============ BROWSER ============
void browserApp() {
  if(!wifiConnected) {
    Serial.println("WiFi required!");
    delay(2000);
    currentApp = "home";
    return;
  }
 
  Serial.println("BROWSER");
  Serial.println("Enter search:");
  Serial.print("> ");
 
  while(!Serial.available()) yield();
  String search = Serial.readStringUntil('\n');
  search.trim();
 
  if(search == "b") { currentApp = "home"; return; }
 
  Serial.println("Searching...");
 
  WiFiClientSecure client;
  client.setInsecure();
  HTTPClient http;
 
  String url = "https://en.wikipedia.org/api/rest_v1/page/summary/" + search;
  url.replace(" ", "_");
 
  http.begin(client, url);
  int code = http.GET();
 
  if(code == 200) {
    String data = http.getString();
   
    int ts = data.indexOf("\"title\":\"") + 9;
    int te = data.indexOf("\"", ts);
    String title = data.substring(ts, te);
   
    int es = data.indexOf("\"extract\":\"") + 11;
    int ee = data.indexOf("\"", es);
    String extract = data.substring(es, ee);
   
    Serial.println("\n=== " + title + " ===");
    Serial.println(extract.substring(0, 500));
  } else {
    Serial.println("Not found!");
  }
 
  http.end();
  Serial.println("\nPress any key...");
  while(!Serial.available()) yield();
  Serial.read();
 
  currentApp = "home";
}

