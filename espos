// ============ CALCULATOR ============
void calculatorApp() {
  Display::clear();
  Display::print(0, 0, "CALCULATOR");
  Display::print(0, 0, "Ops: +,-,*,/,^,s(sqrt)");
  Display::print(0, 0, "Func: sin,cos,tan,log");
  Display::print(0, 0, "Mem: m,r,c(clr),b(back)");
  Display::print(0, 0, "Display: " + calcDisplay);
  Serial.print("> ");
 
  String buf = "";
  while(true) {
    if(Serial.available()) {
      char in = Serial.read();
     
      if(in == '\n' || in == '\r') {
        if(buf == "b") { currentApp = "home"; return; }
        if(buf == "c") { calcDisplay = "0"; calcMemory = 0; lastOp = '='; }
        else if(buf.startsWith("sin")) calcDisplay = String(sin(calcDisplay.toDouble() * PI / 180));
        else if(buf.startsWith("cos")) calcDisplay = String(cos(calcDisplay.toDouble() * PI / 180));
        else if(buf.startsWith("tan")) calcDisplay = String(tan(calcDisplay.toDouble() * PI / 180));
        else if(buf.startsWith("log")) calcDisplay = String(log10(calcDisplay.toDouble()));
        else if(buf == "s") calcDisplay = String(sqrt(calcDisplay.toDouble()));
        else if(buf.length() > 0) calcDisplay = buf;
       
        buf = "";
        Display::clear();
        Display::print(0, 20, calcDisplay);
        Display::show();
        Serial.println("= " + calcDisplay);
        Serial.print("> ");
        continue;
      }
     
      if(in == '+' || in == '-' || in == '*' || in == '/') {
        double cur = calcDisplay.toDouble();
        if(lastOp == '+') calcMemory += cur;
        else if(lastOp == '-') calcMemory -= cur;
        else if(lastOp == '*') calcMemory *= cur;
        else if(lastOp == '/') calcMemory /= cur;
        else calcMemory = cur;
       
        lastOp = in;
        calcDisplay = String(calcMemory);
        Serial.println("= " + calcDisplay);
        calcDisplay = "0";
        Serial.print("> ");
      }
      else if(in == '=') {
        double cur = calcDisplay.toDouble();
        if(lastOp == '+') calcMemory += cur;
        else if(lastOp == '-') calcMemory -= cur;
        else if(lastOp == '*') calcMemory *= cur;
        else if(lastOp == '/') calcMemory /= cur;
       
        calcDisplay = String(calcMemory);
        Serial.println("= " + calcDisplay);
        lastOp = '=';
        calcMemory = 0;
        Serial.print("> ");
      }
      else {
        buf += in;
        Serial.print(in);
      }
    }
    yield();
  }
}

// ============ WIFI ============
void wifiApp() {
  Display::clear();
 
  #ifdef USE_OLED
    Display::printCenter(0, "WiFi Settings");
    Display::line(0, 10, 128, 10);
    if(wifiConnected) {
      Display::print(0, 14, WiFi.SSID().substring(0, 20));
      Display::print(0, 24, WiFi.localIP().toString());
      Display::print(0, 34, "Signal:" + String(WiFi.RSSI()));
      Display::print(0, 54, "Use serial menu");
    } else {
      Display::printCenter(28, "Not connected");
      Display::print(0, 54, "Use serial setup");
    }
    Display::show();
  #endif
 
  Serial.println("WiFi Settings");
  if(wifiConnected) {
    Serial.println("Connected: " + WiFi.SSID());
    Serial.println("IP: " + WiFi.localIP().toString());
    Serial.println("1.Disconnect 2.New 3.Forget 4.Back");
    Serial.print("> ");
   
    while(!Serial.available()) yield();
    char c = Serial.read();
   
    if(c == '1') { WiFi.disconnect(); wifiConnected = false; }
    else if(c == '3') { EEPROM.write(ADDR_WIFI_CONFIGURED, 0); EEPROM.commit(); }
    else if(c != '2') { currentApp = "home"; return; }
  }
 
  // Ask for SSID first
  String ssid = "";
  bool ssidConfirmed = false;
  while(!ssidConfirmed) {
    Serial.println("\nEnter SSID (or 'cancel' to abort):");
    Serial.print("> ");
    while(!Serial.available()) yield();
    ssid = Serial.readStringUntil('\n');
    ssid.trim();
    
    if(ssid.length() == 0) continue;
    
    if(ssid.equalsIgnoreCase("cancel")) {
      currentApp = "home";
      return;
    }
    
    Serial.println("SSID: \"" + ssid + "\"");
    Serial.println("Confirm? (y/n/cancel):");
    Serial.print("> ");
    
    while(!Serial.available()) yield();
    char confirm = Serial.read();
    Serial.readStringUntil('\n'); // Clear any remaining input
    
    if(confirm == 'y' || confirm == 'Y') {
      ssidConfirmed = true;
    } else if(confirm == 'c' || confirm == 'C') {
      currentApp = "home";
      return;
    }
    // If 'n', loop continues to ask for SSID again
  }
 
  // Ask for password
  String pass = "";
  bool passConfirmed = false;
  while(!passConfirmed) {
    Serial.println("\nEnter Password (or 'skip' for open network):");
    Serial.print("> ");
    while(!Serial.available()) yield();
    pass = Serial.readStringUntil('\n');
    pass.trim();
    
    Serial.println("Password: " + String(pass.length() > 0 ? "*****" : "[empty]"));
    Serial.println("Confirm? (y/n/cancel):");
    Serial.print("> ");
    
    while(!Serial.available()) yield();
    char confirm = Serial.read();
    Serial.readStringUntil('\n'); // Clear any remaining input
    
    if(confirm == 'y' || confirm == 'Y') {
      passConfirmed = true;
    } else if(confirm == 'c' || confirm == 'C') {
      currentApp = "home";
      return;
    }
    // If 'n', loop continues to ask for password again
  }
  
  // Final confirmation with both SSID and password
  Serial.println("\n--- WiFi Configuration ---");
  Serial.println("SSID: \"" + ssid + "\"");
  Serial.println("Password: " + String(pass.length() > 0 ? "*****" : "[open network]"));
  Serial.println("Connect with these settings? (y/n):");
  Serial.print("> ");
  
  while(!Serial.available()) yield();
  char finalConfirm = Serial.read();
  Serial.readStringUntil('\n'); // Clear any remaining input
  
  if(finalConfirm != 'y' && finalConfirm != 'Y') {
    Serial.println("Cancelled.");
    currentApp = "home";
    return;
  }
 
  Serial.println("\nConnecting...");
  WiFi.begin(ssid.c_str(), pass.c_str());
 
  int tries = 0;
  while(WiFi.status() != WL_CONNECTED && tries < 30) {
    delay(500);
    Serial.print(".");
    tries++;
  }
 
  if(WiFi.status() == WL_CONNECTED) {
    wifiConnected = true;
    udp.begin(UDP_PORT);
    Serial.println("\nConnected! IP: " + WiFi.localIP().toString());
    
    // Ask about saving to EEPROM
    Serial.println("Save to memory? (y/n):");
    Serial.print("> ");
    while(!Serial.available()) yield();
    char save = Serial.read();
    Serial.readStringUntil('\n'); // Clear any remaining input
    
    if(save == 'y' || save == 'Y') {
      saveWiFi(ssid, pass);
    }
  } else {
    Serial.println("\nFailed to connect!");
  }
 
  delay(3000);
  currentApp = "home";
}

// ============ FLAPPY BIRD ============
void flappyBird() {
  int birdY = 5, vel = 0, obsX = 25, gapY = 4, score = 0;
  bool over = false;
  unsigned long last = millis();
 
  while(!over) {
    if(millis() - last > 150) {
      vel++;
      birdY += vel;
      if(birdY < 0) birdY = 0;
      if(birdY >= 10) over = true;
     
      obsX--;
      if(obsX < 0) { obsX = 25; gapY = random(2, 7); score++; }
     
      if(obsX >= 3 && obsX <= 5 && (birdY < gapY || birdY >= gapY + 4)) over = true;
     
      #ifdef USE_OLED
        Display::clear();
        for(int y = 0; y < 10; y++) {
          for(int x = 0; x < 25; x++) {
            if(x == 4 && y == birdY) Display::pixel(x * 5, y * 6);
            else if(x == obsX && (y < gapY || y >= gapY + 4)) Display::rect(x * 5, y * 6, 4, 5, true);
          }
        }
        Display::print(0, 0, "Score:" + String(score));
        Display::show();
      #else
        Serial.println("\n");
        for(int y = 0; y < 10; y++) {
          for(int x = 0; x < 30; x++) {
            if(x == 4 && y == birdY) Serial.print(">");
            else if(x == obsX && (y < gapY || y >= gapY + 4)) Serial.print("#");
            else Serial.print(" ");
          }
          Serial.println("|");
        }
        Serial.println("Score: " + String(score) + " High: " + String(highScoreFlappy));
      #endif
     
      last = millis();
    }
   
    if(Serial.available()) {
      char c = Serial.read();
      if(c == ' ') vel = -3;
      if(c == 'q') return;
    }
    yield();
  }
 
  if(score > highScoreFlappy) { highScoreFlappy = score; saveScore(0, score); }
  Serial.println("\nGame Over! Score: " + String(score));
  delay(3000);
}

// ============ PLATFORM RUNNER ============
void marioGame() {
  int pX = 5, pY = 7, velY = 0, worldX = 0, score = 0;
  bool ground = true, over = false;
  unsigned long last = millis();
  int platforms[] = {7, 7, 5, 7, 4, 7, 6, 7, 7, 5};
 
  while(!over) {
    if(millis() - last > 120) {
      if(!ground) { velY++; pY += velY; }
     
      ground = false;
      int plat = platforms[(worldX / 5) % 10];
      if(pY >= plat && pY < plat + 1) { pY = plat; velY = 0; ground = true; }
     
      if(pY > 9) over = true;
      worldX++;
      score++;
     
      #ifdef USE_OLED
        Display::clear();
        for(int y = 0; y < 10; y++) {
          for(int x = 0; x < 25; x++) {
            if(x == pX && y == pY) Display::pixel(x * 5, y * 6);
            else {
              int wx = worldX + x;
              int ph = platforms[(wx / 5) % 10];
              if(y == ph && wx % 5 < 3) Display::pixel(x * 5, y * 6);
            }
          }
        }
        Display::print(0, 0, "Score:" + String(score));
        Display::show();
      #else
        Serial.println("\n");
        for(int y = 0; y < 10; y++) {
          for(int x = 0; x < 30; x++) {
            if(x == pX && y == pY) Serial.print("@");
            else {
              int wx = worldX + x;
              int ph = platforms[(wx / 5) % 10];
              if(y == ph && wx % 5 < 3) Serial.print("=");
              else Serial.print(" ");
            }
          }
          Serial.println("|");
        }
        Serial.println("Score: " + String(score) + " High: " + String(highScoreMario));
      #endif
     
      last = millis();
    }
   
    if(Serial.available()) {
      char c = Serial.read();
      if(c == ' ' && ground) { velY = -3; ground = false; }
      if(c == 'q') return;
    }
    yield();
  }
 
  if(score > highScoreMario) { highScoreMario = score; saveScore(1, score); }
  Serial.println("\nGame Over! Score: " + String(score));
  delay(3000);
}

// ============ FIGHTER ============
void fighterGame() {
  int pH = 100, eH = 100, wins = 0;
 
  while(wins < 3) {
    Display::clear();
    Display::print(0, 0, "FIGHTER - Round " + String(wins + 1));
    Display::print(0, 10, "Player: " + String(pH) + "/100");
    Display::print(0, 20, "Enemy: " + String(eH) + "/100");
    Display::print(0, 40, "a:punch s:kick d:block");
    Display::print(0, 50, "SPACE:special q:quit");
    Display::show();
   
    if(Serial.available()) {
      char c = Serial.read();
     
      if(c == 'q') return;
      else if(c == 'a') { eH -= random(8, 15); Serial.println("You punch!"); }
      else if(c == 's') { eH -= random(12, 20); Serial.println("You kick!"); }
      else if(c == ' ') { eH -= random(20, 30); Serial.println("SPECIAL!"); }
     
      // Enemy turn
      int eMove = random(0, 3);
      if(eMove == 0) { pH -= random(8, 15); Serial.println("Enemy punches!"); }
      else if(eMove == 1) { pH -= random(12, 20); Serial.println("Enemy kicks!"); }
      else if(eMove == 2) { pH -= random(20, 30); Serial.println("Enemy special!"); }
     
      delay(500);
    }
   
    if(pH <= 0 || eH <= 0) {
      if(eH <= 0) {
        wins++;
        Serial.println("Round won!");
        pH = 100;
        eH = 100;
      } else {
        Serial.println("You lose! Wins: " + String(wins));
        if(wins > highScoreFighter) { highScoreFighter = wins; saveScore(2, wins); }
        delay(3000);
        return;
      }
    }
   
    yield();
  }
 
  Serial.println("Champion! 3 wins!");
  if(wins > highScoreFighter) { highScoreFighter = wins; saveScore(2, wins); }
  delay(3000);
}

