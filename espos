// ============ SETUP ============
void setup() {
  Display::init();
  EEPROM.begin(EEPROM_SIZE);
  WiFi.mode(WIFI_STA);
  randomSeed(analogRead(A0));
 
  Display::clear();
  Display::printCenter(28, "Booting...");
  Display::show();
  Serial.println("Booting " + String(VERSION));
 
  highScoreFlappy = loadScore(0);
  highScoreMario = loadScore(1);
  highScoreFighter = loadScore(2);
 
  String ssid, pass;
  if(loadWiFi(ssid, pass)) {
    Serial.println("Auto-connecting...");
    WiFi.begin(ssid.c_str(), pass.c_str());
   
    int tries = 0;
    while(WiFi.status() != WL_CONNECTED && tries < 20) {
      delay(500);
      Serial.print(".");
      tries++;
    }
   
    if(WiFi.status() == WL_CONNECTED) {
      wifiConnected = true;
      udp.begin(UDP_PORT);
      Serial.println("\nConnected!");
    }
  }
 
  delay(2000);
  currentApp = "home";
}

// ============ MAIN LOOP ============
void loop() {
  if(currentApp == "home") {
    showHome();
   
    while(!Serial.available()) yield();
    char c = Serial.read();
   
    if(c >= '1' && c <= '7') {
      menuSelection = c - '1';
      if(c == '1') currentApp = "calculator";
      else if(c == '2') currentApp = "wifi";
      else if(c == '3') currentApp = "messenger";
      else if(c == '4') currentApp = "gamezone";
      else if(c == '5') currentApp = "browser";
      else if(c == '6') currentApp = "sysinfo";
      else if(c == '7') currentApp = "customappexample";
      else if(c == '8') { Serial.println("Goodbye!"); ESP.deepSleep(0); }
    }
  }
  else if(currentApp == "calculator") calculatorApp();
  else if(currentApp == "wifi") wifiApp();
  else if(currentApp == "messenger") messengerApp();
  else if(currentApp == "gamezone") gameZone();
  else if(currentApp == "browser") browserApp();
  else if(currentApp == "sysinfo") sysInfo();
  else if(currentApp == "customappexample") customApp();
 
  yield();
}
